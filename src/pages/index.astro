---
import Base from '../layouts/Base.astro';
import data from '../../data/releases.json';

const releases = data.releases || [];
const latest = releases[0] || {};
const recent = releases.slice(0, 6);
// 안정화(데이터무결성/보안/호환성) 하이라이트
const stable = releases.filter(r => ['data-integrity', 'security', 'compat'].includes(r.category)).slice(0, 5);
const total = data.count || releases.length;
const importantCount = releases.filter(r => r.important).length;
const badgeClass = (c) => ['security','data-integrity','feature','compat','performance','consistency','refactor','fix'].includes(c) ? c : 'fix';
// AEO/GEO: FAQ — 답변엔진이 그대로 인용할 수 있는 질문-답 쌍 (본문 섹션과 1:1 동일 내용)
const faq = [
  { q: 'leerness가 뭐예요?', a: 'AI 코딩 에이전트(Claude Code, Cursor, Codex 등) 위에 얹는 운영 레이어입니다. 작업 기억·완료 검증·보안 가드·인수인계를 .harness/ 폴더의 일반 파일로 영속화해서, 어떤 에이전트가 와도 일이 이어지고 결과를 믿을 수 있게 만듭니다.' },
  { q: 'leerness가 코드를 대신 써주나요?', a: '아니요. 애플리케이션 코드는 에이전트가 쓰고, leerness는 그 작업이 기억되고 검증되고 안전하게 인계되도록 챙깁니다. 기본 동작은 LLM 호출·코드 실행이 없으며, 옵트인 기능(에이전트 오케스트레이션, verify-claim --run-tests의 프로젝트 테스트 실행)을 켠 경우에만 설정한 도구를 호출합니다.' },
  { q: '어떻게 시작하나요?', a: 'npm i -g leerness 로 설치하고, 프로젝트에서 leerness init . 을 실행한 뒤, 매 세션 시작 시 leerness handoff . 로 컨텍스트를 로드하면 됩니다. Node.js 18 이상이면 되고 런타임 의존성은 0개입니다.' },
  { q: 'AI가 "다 했어요"라고 거짓말하면요?', a: 'leerness verify-claim 이 완료 주장을 실제 파일 존재·테스트 실행 결과·git 변경과 대조해서 증거 없는 완료를 차단합니다. leerness lazy detect 는 증거 없는 done, 빈 인수인계, 테스트 미실행 신호를 자동 감지합니다.' },
  { q: '어떤 에이전트와 함께 쓸 수 있나요?', a: 'CLI를 실행하거나 MCP를 쓸 수 있는 모든 에이전트와 호환됩니다 — Claude Code, Cursor, Codex CLI, GitHub Copilot, Goose 등. MCP 서버(leerness mcp serve)가 86개 도구를 노출합니다.' },
  { q: '내 데이터가 외부로 전송되나요?', a: '아니요. 모든 상태는 로컬 일반 파일(.harness/)에 저장되고, 도구 자체가 offline-first에 런타임 의존성 0개, 설치 스크립트 0개입니다.' },
];
const faqJsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="leerness — AI 코딩 에이전트를 위한 운영 레이어" jsonld={faqJsonld}>
  <section class="hero">
    <h1>AI 코딩 에이전트를 위한<br /><span class="grad">운영 레이어 (operating layer)</span></h1>
    <p class="tag">기억 · 인수인계 · 검증 · 감사 · 보안 가드를 <code>.harness/</code> 에 영속화 — 코드를 대신 쓰지 않고, 어떤 에이전트 위에도 얹는 공통 운영 계층. 0 의존성 · offline-first · MCP 88 도구 · 온톨로지 그래프.</p>
    <div class="install"><span class="pfx">$ </span>npm i -g leerness</div>
    <div class="cta">
      <a class="btn primary" href="/how-it-works">leerness가 해주는 일 →</a>
      <a class="btn ghost" href="/changelog">패치노트</a>
      <a class="btn ghost" href="https://github.com/gugu9999gu/leerness" target="_blank" rel="noopener">GitHub</a>
    </div>
    <div class="stats">
      <div class="stat"><div class="n">v{latest.version || '—'}</div><div class="l">최신 버전</div></div>
      <div class="stat"><div class="n">{total}</div><div class="l">릴리스</div></div>
      <div class="stat"><div class="n">0</div><div class="l">의존성</div></div>
      <div class="stat"><div class="n">88</div><div class="l">MCP 도구</div></div>
    </div>
  </section>

  <section id="plain">
    <h2>쉽게 말하면 🙂</h2>
    <p class="sub">개발을 몰라도 괜찮아요. <b>AI에게 코딩을 시키면 똑똑하지만, 가끔 하던 걸 깜빡하거나 "다 했어요"라고만 하고 실제로는 안 끝낸 경우</b>가 있어요. leerness는 그 AI 옆에서 일을 <b>꼼꼼히 챙겨주는 비서</b>예요 — 직접 코딩하진 않고, AI가 실수 없이 일하도록 돕습니다.</p>
    <div class="plain-grid">
      <div class="pcard"><div class="pico">🧠</div><div class="pt">하던 일을 기억해요</div><div class="ps">대화가 끊기거나 다음 날 다시 시켜도, 어디까지 했는지 잊지 않고 이어가요.</div></div>
      <div class="pcard"><div class="pico">✅</div><div class="pt">"다 했어요"를 확인해요</div><div class="ps">정말 끝났는지 증거(테스트·결과)로 점검해서, 안 끝난 걸 끝났다고 말하지 못하게 해요.</div></div>
      <div class="pcard"><div class="pico">🛡️</div><div class="pt">사고를 미리 막아요</div><div class="ps">비밀번호 유출, 한글 깨짐 같은 흔한 실수를 일을 마치기 전에 자동으로 잡아줘요.</div></div>
      <div class="pcard"><div class="pico">🤝</div><div class="pt">다음 사람에게 넘겨줘요</div><div class="ps">다른 AI 도구나 동료가 이어받을 때, 무엇을 왜 했는지 정리해 깔끔하게 인계해요.</div></div>
    </div>
    <p class="sub" style="margin-top:18px">한 줄 요약: <b>AI가 만든 결과를 믿을 수 있게, 기억·확인·안전을 자동으로 챙겨주는 도구.</b></p>
  </section>

  <section id="about">
    <h2>leerness 란? <span style="font-size:.6em;color:#9aa0ad">(개발자용)</span></h2>
    <p class="sub">AI 코딩 에이전트(Claude Code, Cursor, Codex 등)는 코드를 잘 쓰지만 <b>기억하지 못하고, 증거 없이 "완료"를 선언</b>합니다. leerness 는 그 위에 얹는 <b>운영 레이어</b> — 프로젝트 상태를 <code>.harness/</code> 파일로 영속화하고 CLI · MCP 도구로 노출합니다. <b>leerness 자체는 애플리케이션 코드를 쓰지 않습니다</b> — 기본 동작은 LLM 호출·코드 실행 없음, 옵트인 오케스트레이션/테스트 실행만 예외.</p>
    <div class="rel" style="cursor:default">
      <div class="title">🤝 핸드오프 — 세션 시작 시 컨텍스트 자동 로드, 종료 시 인수인계 생성</div>
      <div class="summ">progress-tracker · decisions · lessons · rules 를 읽어 다음 에이전트가 이어받음</div>
    </div>
    <div class="rel" style="cursor:default">
      <div class="title">🔍 자기검증 — 거짓 완료/게으름 감지 + 증거 기반 게이트</div>
      <div class="summ">done 인데 evidence 없음 · 테스트 미실행 · 추적 안 된 TODO 자동 점검</div>
    </div>
    <div class="rel" style="cursor:default">
      <div class="title">🔐 보안·인코딩 — 시크릿 스캔 + 한글 UTF-8/BOM/CRLF 검사</div>
      <div class="summ">하드코딩 시크릿·gitignore 정합·셸 스크립트 인코딩 위험 자동 탐지</div>
    </div>
  </section>

  <section id="visualize">
    <h2>🕸️ 온톨로지 그래프 <span class="badge feature">NEW</span></h2>
    <p class="sub"><code>leerness graph --html</code> — 프로젝트 하네스(작업·계획·결정·교훈·룰·스킬·기능)를 <b>하나의 인터랙티브 그래프</b>(self-contained <code>leerness.html</code>)로 표면화합니다. 노드를 클릭하면 내용이 바로 열리고 — 검색·타입 필터·자동 맞춤(fit)·PNG 내보내기까지. 0 의존성 vanilla JS라 파일 하나로 어떤 브라우저에서나 열립니다.</p>
    <div style="margin-top:14px;border:1px solid #222a33;border-radius:14px;overflow:hidden;background:#0a0d12;box-shadow:0 24px 60px -28px #000">
      <iframe src="/graph-demo.html" title="leerness 온톨로지 그래프 데모" loading="lazy" style="width:100%;height:540px;border:0;display:block"></iframe>
    </div>
    <p class="sub" style="margin-top:10px">↑ 샘플 프로젝트의 실제 그래프 — 노드 드래그 · 스크롤 줌 · 클릭하면 내용 패널. <a href="/graph-demo.html" target="_blank" rel="noopener">전체 화면으로 열기 →</a> · <code>LEERNESS_AUTO_GRAPH=1</code> 로 <code>handoff</code> 마다 자동 갱신.</p>
  </section>

  <section id="latest">
    <h2>최근 릴리스</h2>
    <p class="sub">CHANGELOG 자동 동기화 · 총 {total}개 중 중요 업데이트 {importantCount}건</p>
    {recent.map(r => (
      <a class="rel" href={`/changelog/${r.version}`}>
        <div class="top">
          <span class="ver">v{r.version}</span>
          <span class={`badge ${badgeClass(r.category)}`}>{r.categoryKo}{r.important ? ' ★' : ''}</span>
          <span class="date">{r.date}</span>
        </div>
        <div class="title">{r.title}</div>
        {r.summary && <div class="summ">{r.summary}</div>}
      </a>
    ))}
    <p style="margin-top:14px"><a href="/changelog">전체 패치노트 →</a></p>
  </section>

  {stable.length > 0 && (
    <section id="stable">
      <h2>안정화 하이라이트</h2>
      <p class="sub">데이터 무결성 · 보안 · 호환성 — 핵심 안정화 업데이트</p>
      {stable.map(r => (
        <a class="rel" href={`/changelog/${r.version}`}>
          <div class="top">
            <span class="ver">v{r.version}</span>
            <span class={`badge ${badgeClass(r.category)}`}>{r.categoryKo}</span>
            <span class="date">{r.date}</span>
          </div>
          <div class="title">{r.title}</div>
        </a>
      ))}
    </section>
  )}

  <section id="faq">
    <h2>자주 묻는 질문 (FAQ)</h2>
    {faq.map(f => (
      <details class="rel" style="cursor:pointer">
        <summary class="title" style="font-weight:600">{f.q}</summary>
        <p class="summ" style="margin:10px 0 4px">{f.a}</p>
      </details>
    ))}
  </section>
</Base>
